{
  "name": "my-report-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:angular": "ng build angular",
    "build:elements": "node scripts/build-elements.mjs",
    "build:react": "tsc -p projects/react && node -e \"for (const f of ['package.json','README.md']) require('fs').copyFileSync('projects/react/'+f,'dist/react/'+f)\"",
    "build:angular-legacy": "node scripts/build-angular-legacy.mjs",
    "build:packages": "npm run build:angular && npm run build:elements && npm run build:react && npm run build:angular-legacy",
    "pack:packages": "npm run build:packages && cd dist/angular && npm pack && cd ../elements && npm pack && cd ../react && npm pack && cd ../angular-legacy && npm pack"
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/elements": "~19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "qrcode-generator": "^1.4.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "ng-packagr": "~19.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2"
  }
}
